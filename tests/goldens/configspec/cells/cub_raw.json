{
  "backend": {
    "name": "vllm",
    "params": {
      "engine_kwargs": {
        "enable_prefix_caching": false,
        "enforce_eager": true,
        "max_num_batched_tokens": 16384,
        "max_num_seqs": 512
      },
      "max_inflight": 512,
      "model_path": "/path/to/Qwen3.5-9B",
      "prefetch_workers": 8,
      "profile": {
        "thinking_kwarg": "enable_thinking",
        "type": "hf_template"
      }
    }
  },
  "budget": {
    "name": "flat",
    "params": {}
  },
  "eval_model": {
    "name": "absolute"
  },
  "protocol": {
    "name": "identity"
  },
  "run": {
    "final_eval": {
      "split": "test"
    },
    "name": "quickstart_cub_raw",
    "seed": 42
  },
  "strategy": {
    "name": "raw",
    "params": {},
    "seeds": [
      "Classify the content of the target image."
    ]
  },
  "task": {
    "name": "mcq",
    "params": {
      "data_dir": "datasets/quickstart/cub/data",
      "dataset": "cub",
      "images_dir": "datasets/quickstart/cub/images",
      "train_per_group": 0
    }
  }
}
